# Copy to .env (untracked). The key never leaves the server process and is redacted from logs.
GEMINI_API_KEY= 

# HTTP/WebSocket port
PORT=8080

# Protect the hosted key: concurrent live sessions using the server key, and the hard cap per session.
PARLEY_MAX_SESSIONS=8
PARLEY_SESSION_MAX_MINUTES=12

# Let a visitor paste their own Gemini key in the browser (1 = allowed, 0 = off).
PARLEY_ALLOW_BYOK=1

# Model overrides (defaults shown).
# PARLEY_LIVE_MODEL=gemini-3.8-live
# PARLEY_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
# PARLEY_TRANSCRIBE_LIVE_MODEL=gemini-3.5-transcribe-live
# PARLEY_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# PARLEY_TTS_MODEL=gemini-3.8-flash-tts
# PARLEY_TTS_FAST_MODEL=gemini-3.8-flash-lite-tts
# PARLEY_FLASH_MODEL=gemini-3.8-flash
